{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://REPLACE-WITH-YOUR-VERCEL-URL.vercel.app"
      }
    },
    "preview": {
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://REPLACE-WITH-YOUR-VERCEL-URL.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://REPLACE-WITH-YOUR-VERCEL-URL.vercel.app"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleTeamId": "8G5Y85C7V2",
        "ascAppId": "6778115293"
      }
    },
    "production": {
      "ios": {
        "appleTeamId": "8G5Y85C7V2",
        "ascAppId": "6778115293"
      }
    }
  }
}
