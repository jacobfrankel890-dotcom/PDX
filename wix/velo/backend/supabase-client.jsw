import { fetch } from "wix-fetch";
import { getSecret } from "wix-secrets-backend";

/**
 * Public Supabase config safe to pass to HTML embeds (anon key only).
 * Call from page code — do NOT import wix-secrets-backend in pages.
 */
export async function getPublicConfig() {
  const [supabaseUrl, supabaseAnonKey] = await Promise.all([
    getSecret("SUPABASE_URL"),
    getSecret("SUPABASE_ANON_KEY"),
  ]);
  return { supabaseUrl, supabaseAnonKey };
}

/**
 * Low-level Supabase REST helper using the service role key.
 * Only import from backend modules — never expose to the frontend.
 */
export async function supabaseRest(path, options = {}) {
  const baseUrl = (await getSecret("SUPABASE_URL")).replace(/\/$/, "");
  const serviceKey = await getSecret("SUPABASE_SERVICE_ROLE_KEY");

  const headers = {
    apikey: serviceKey,
    Authorization: `Bearer ${serviceKey}`,
    "Content-Type": "application/json",
    ...options.headers,
  };

  if (options.prefer) {
    headers.Prefer = options.prefer;
  }

  const response = await fetch(`${baseUrl}/rest/v1/${path}`, {
    method: options.method || "GET",
    headers,
    body: options.body ? JSON.stringify(options.body) : undefined,
  });

  const text = await response.text();
  let data = null;
  if (text) {
    try {
      data = JSON.parse(text);
    } catch {
      data = text;
    }
  }

  if (!response.ok) {
    const message =
      (data && data.message) ||
      (data && data.error_description) ||
      (typeof data === "string" ? data : "Supabase request failed");
    throw new Error(message);
  }

  return data;
}

/**
 * Signed URL for a private storage object (receipts, avatars, etc.).
 */
export async function createSignedStorageUrl(bucket, storagePath, expiresIn = 3600) {
  if (!storagePath) return null;

  const baseUrl = (await getSecret("SUPABASE_URL")).replace(/\/$/, "");
  const serviceKey = await getSecret("SUPABASE_SERVICE_ROLE_KEY");
  const encodedPath = storagePath
    .split("/")
    .map((segment) => encodeURIComponent(segment))
    .join("/");

  const response = await fetch(`${baseUrl}/storage/v1/object/sign/${bucket}/${encodedPath}`, {
    method: "POST",
    headers: {
      apikey: serviceKey,
      Authorization: `Bearer ${serviceKey}`,
      "Content-Type": "application/json",
    },
    body: JSON.stringify({ expiresIn }),
  });

  const data = await response.json();
  if (!response.ok) {
    return null;
  }

  const signed = data.signedURL || data.signedUrl;
  if (!signed) return null;
  if (signed.startsWith("http")) return signed;
  return `${baseUrl}/storage/v1${signed.startsWith("/") ? signed : `/${signed}`}`;
}

/**
 * Upload a file to Supabase Storage (service role — bypasses RLS).
 */
export async function uploadStorageObject(bucket, storagePath, content, contentType) {
  const baseUrl = (await getSecret("SUPABASE_URL")).replace(/\/$/, "");
  const serviceKey = await getSecret("SUPABASE_SERVICE_ROLE_KEY");
  const encodedPath = storagePath
    .split("/")
    .map((segment) => encodeURIComponent(segment))
    .join("/");

  const response = await fetch(`${baseUrl}/storage/v1/object/${bucket}/${encodedPath}`, {
    method: "POST",
    headers: {
      apikey: serviceKey,
      Authorization: `Bearer ${serviceKey}`,
      "Content-Type": contentType || "application/octet-stream",
      "x-upsert": "true",
    },
    body: content,
  });

  const text = await response.text();
  if (!response.ok) {
    let message = text || "Storage upload failed";
    try {
      const parsed = JSON.parse(text);
      message = parsed.message || parsed.error || message;
    } catch (_) {}
    throw new Error(message);
  }

  return storagePath;
}

/**
 * Signed upload URL so the HTML embed can PUT a statement file directly to Supabase
 * (avoids sending large PDF base64 through Wix postMessage).
 */
export async function createSignedUploadUrl(bucket, storagePath) {
  const baseUrl = (await getSecret("SUPABASE_URL")).replace(/\/$/, "");
  const storageV1 = `${baseUrl}/storage/v1`;
  const serviceKey = await getSecret("SUPABASE_SERVICE_ROLE_KEY");
  const encodedPath = storagePath
    .split("/")
    .map((segment) => encodeURIComponent(segment))
    .join("/");

  const response = await fetch(`${storageV1}/object/upload/sign/${bucket}/${encodedPath}`, {
    method: "POST",
    headers: {
      apikey: serviceKey,
      Authorization: `Bearer ${serviceKey}`,
      "Content-Type": "application/json",
      "x-upsert": "true",
    },
    body: JSON.stringify({}),
  });

  const text = await response.text();
  let data = {};
  try {
    data = text ? JSON.parse(text) : {};
  } catch (_) {
    throw new Error(text.slice(0, 160) || "Could not create upload URL");
  }

  if (!response.ok) {
    const hint = /bucket/i.test(text) ? " — run supabase/cc-statements-migration.sql in Supabase SQL editor" : "";
    throw new Error((data.message || data.error || text.slice(0, 160) || "Could not create upload URL") + hint);
  }

  const relUrl = data.url || "";
  let signedUrl = data.signedUrl || "";
  let token = data.token || "";

  if (!signedUrl && relUrl) {
    const absolute = relUrl.startsWith("http")
      ? relUrl
      : `${storageV1}${relUrl.startsWith("/") ? relUrl : `/${relUrl}`}`;
    signedUrl = absolute;
    try {
      if (!token) token = new URL(absolute).searchParams.get("token") || "";
    } catch (_) {}
  }

  if (!signedUrl) {
    throw new Error("Invalid upload sign response from Supabase");
  }

  return { signedUrl, token, path: storagePath };
}

/**
 * Full URL for avatar or receipt — http(s) passthrough, else sign storage path.
 */
export async function resolveImageUrl(urlOrPath, bucket = "receipts") {
  if (!urlOrPath) return null;
  const trimmed = urlOrPath.trim();
  if (trimmed.startsWith("http://") || trimmed.startsWith("https://")) {
    return trimmed;
  }
  return createSignedStorageUrl(bucket, trimmed);
}

/**
 * Validate a Supabase user JWT and ensure the email is in ADMIN_EMAILS.
 */
export async function verifyAdminAccessToken(accessToken) {
  if (!accessToken) {
    throw new Error("Missing access token");
  }

  const baseUrl = (await getSecret("SUPABASE_URL")).replace(/\/$/, "");
  const anonKey = await getSecret("SUPABASE_ANON_KEY");

  const response = await fetch(`${baseUrl}/auth/v1/user`, {
    headers: {
      Authorization: `Bearer ${accessToken}`,
      apikey: anonKey,
    },
  });

  const user = await response.json();
  if (!response.ok) {
    throw new Error(user?.msg || user?.message || "Invalid session");
  }

  const adminEmailsRaw = await getSecret("ADMIN_EMAILS");
  const adminEmails = adminEmailsRaw
    .split(",")
    .map((e) => e.trim().toLowerCase())
    .filter(Boolean);

  const email = (user.email || "").toLowerCase();
  if (!adminEmails.includes(email)) {
    throw new Error("You do not have admin access");
  }

  return user;
}

/** Short-lived invoke config for PDF AI parse (browser calls edge fn — avoids Wix 14s backend limit). */
export async function getStatementAnalyzeInvoke() {
  const baseUrl = (await getSecret("SUPABASE_URL")).replace(/\/$/, "");
  const anonKey = await getSecret("SUPABASE_ANON_KEY");
  return {
    analyzeUrl: `${baseUrl}/functions/v1/analyze-statement`,
    apikey: anonKey,
  };
}

/** Invoke analyze-statement edge function (backend only). */
export async function invokeAnalyzeStatement({ fileBase64, mimeType, fileName, storagePath } = {}) {
  const baseUrl = (await getSecret("SUPABASE_URL")).replace(/\/$/, "");
  const serviceKey = await getSecret("SUPABASE_SERVICE_ROLE_KEY");
  const response = await fetch(`${baseUrl}/functions/v1/analyze-statement`, {
    method: "POST",
    headers: {
      Authorization: `Bearer ${serviceKey}`,
      apikey: serviceKey,
      "Content-Type": "application/json",
    },
    body: JSON.stringify({ fileBase64, mimeType, fileName, storagePath }),
  });
  const text = await response.text();
  let json = {};
  try {
    json = text ? JSON.parse(text) : {};
  } catch (_) {
    throw new Error(text.slice(0, 200) || "Statement analysis failed");
  }
  if (!response.ok || !json.ok) {
    throw new Error(json.error || "Statement analysis failed");
  }
  return json;
}
