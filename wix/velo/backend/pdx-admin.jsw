import { supabaseRest, resolveImageUrl, uploadStorageObject, createSignedStorageUrl, createSignedUploadUrl, invokeAnalyzeStatement, getStatementAnalyzeInvoke, getReconcileItemsInvoke, invokeSendPush } from "backend/supabase-client";

// WIX: Backend → Web Modules → ONLY file named "pdx-admin.jsw"
// There must NOT be a pdx-admin.js in this Backend folder — that breaks the build.
// HTTP API lives separately: http-functions.js

// TODO: Re-enable auth (verifyAdminAccessToken) before production.

// --- Credit Card Bill export (inline — no separate file needed in Wix) ---

const EXPORT_CATEGORIES = [
  { key: "travel_lodging", label: "TRV / LOD" },
  { key: "tolls_parking", label: "Toll/Parking" },
  { key: "office_supplies", label: "OFF. SUP & EQP" },
  { key: "meals_entertainment", label: "Meals & Enter." },
  { key: "vehicle_maintenance", label: "Cell & / M" },
  { key: "marketing", label: "Marketing" },
  { key: "misc", label: "Misc." },
  { key: "mileage_calc", label: "Mileage" },
];

const COMPANIES = [
  { value: "cpx", label: "CPX — Canada" },
  { value: "pdx_north", label: "PDX North — Northeast US" },
  { value: "apx", label: "APX — Auto Parts Xpress" },
  { value: "pdx", label: "PDX — Parts Distribution Xpress" },
  { value: "pdx_south", label: "PDX South — Southeast US" },
  { value: "pdx_west", label: "PDX West — Northwest US" },
  { value: "apx_california", label: "APX California — Southwest US / California" },
];

const LEGACY_COMPANY = {
  "Parts Distribution Xpress": "pdx",
  "All Parts Xpress": "apx",
  "Auto Parts Xpress": "apx",
  CPX: "cpx",
};

function ccNormalizeCompanyKey(company, region) {
  if (!company) return region || "";
  if (COMPANIES.some((c) => c.value === company)) return company;
  if (LEGACY_COMPANY[company]) return LEGACY_COMPANY[company];
  if (COMPANIES.some((c) => c.value === region)) return region;
  return company;
}

function ccCompanyLabel(company, region) {
  const key = ccNormalizeCompanyKey(company, region);
  const match = COMPANIES.find((c) => c.value === key);
  return match ? match.label : company || region || "—";
}

function ccCompanyShortLabel(company, region) {
  const full = ccCompanyLabel(company, region);
  const sep = full.indexOf(" — ");
  return sep >= 0 ? full.slice(sep + 3) : full;
}

function ccInitials(firstName, lastName) {
  const f = (firstName || "").trim()[0] || "";
  const l = (lastName || "").trim()[0] || "";
  return (f + l).toUpperCase() || "—";
}

function ccFormatUsDate(isoDate) {
  if (!isoDate) return "";
  const d = new Date(isoDate + "T12:00:00");
  return `${d.getMonth() + 1}/${d.getDate()}/${d.getFullYear()}`;
}

function ccRound2(n) {
  return Math.round(Number(n || 0) * 100) / 100;
}

function ccCategoryAmounts(item) {
  const amounts = {};
  for (const { key } of EXPORT_CATEGORIES) amounts[key] = ccRound2(item[key] || 0);
  return amounts;
}

function ccEmptyCategoryRow() {
  const row = {};
  for (const { key } of EXPORT_CATEGORIES) row[key] = 0;
  return row;
}

function buildCreditCardBillExport({ items, employeeFilter, dateFrom, dateTo, statementTotal }) {
  let filtered = items || [];
  if (employeeFilter) filtered = filtered.filter((row) => row.user_id === employeeFilter);
  if (dateFrom) filtered = filtered.filter((row) => row.expense_date && row.expense_date >= dateFrom);
  if (dateTo) filtered = filtered.filter((row) => row.expense_date && row.expense_date <= dateTo);

  filtered.sort((a, b) => {
    const da = a.expense_date || "";
    const db = b.expense_date || "";
    return da !== db ? da.localeCompare(db) : (a.description || "").localeCompare(b.description || "");
  });

  const categoryTotals = ccEmptyCategoryRow();
  const rows = [];

  for (const item of filtered) {
    const profile = item.profile || {};
    const amounts = ccCategoryAmounts(item);
    const rowTotal = ccRound2(item.row_total || Object.values(amounts).reduce((s, v) => s + v, 0));
    for (const { key } of EXPORT_CATEGORIES) categoryTotals[key] = ccRound2(categoryTotals[key] + amounts[key]);
    rows.push({
      date: ccFormatUsDate(item.expense_date),
      vendor: item.description || "—",
      employee_initials: ccInitials(profile.first_name, profile.last_name),
      employee_name: `${profile.first_name || ""} ${profile.last_name || ""}`.trim(),
      company: ccCompanyShortLabel(item.company || profile.company, profile.region),
      description: item.related_to || "",
      amounts,
      total: rowTotal,
    });
  }

  const grandTotal = ccRound2(Object.values(categoryTotals).reduce((s, v) => s + v, 0));
  const billTotal = statementTotal != null && statementTotal !== "" ? ccRound2(Number(statementTotal)) : null;

  return {
    header: {
      title: "Credit Card Bill",
      employee_name: employeeFilter && filtered[0]?.profile
        ? `${filtered[0].profile.first_name || ""} ${filtered[0].profile.last_name || ""}`.trim()
        : rows.length ? [...new Set(rows.map((r) => r.employee_name))].join(", ") : "All employees",
      date_from: ccFormatUsDate(dateFrom),
      date_to: ccFormatUsDate(dateTo),
      spreadsheet_total: grandTotal,
      statement_total: billTotal,
      difference: billTotal != null ? ccRound2(grandTotal - billTotal) : null,
      line_count: rows.length,
    },
    category_keys: EXPORT_CATEGORIES.map((c) => c.key),
    category_totals: categoryTotals,
    rows,
    grand_total: grandTotal,
  };
}

function ccCsvCell(value) {
  if (value == null || value === "") return "";
  const s = String(value);
  return s.includes(",") || s.includes('"') || s.includes("\n") ? `"${s.replace(/"/g, '""')}"` : s;
}

function ccFormatMoneyCsv(n) {
  if (n == null || n === "" || Number(n) === 0) return "";
  const num = ccRound2(n);
  return num < 0 ? `"(${Math.abs(num).toFixed(2)})"` : num.toFixed(2);
}

function ccFormatMoneyPlain(n) {
  if (n == null || n === "" || Number(n) === 0) return "";
  const num = ccRound2(n);
  return num < 0 ? `(${Math.abs(num).toFixed(2)})` : num.toFixed(2);
}

function creditCardBillToCsv(exportData) {
  const { header, rows, category_keys, category_totals, grand_total } = exportData;
  const catLabels = EXPORT_CATEGORIES.map((c) => c.label);
  const lines = [];
  lines.push(ccCsvCell(header.title));
  lines.push(["Employee", header.employee_name, "", "", "", "From:", header.date_from, "", "To:", header.date_to].map(ccCsvCell).join(","));
  lines.push(["", "", "", "", "", "Total per Spreadsheet:", ccFormatMoneyCsv(header.spreadsheet_total), "", "Total on bill:", header.statement_total != null ? ccFormatMoneyCsv(header.statement_total) : "", "", "Difference:", header.difference != null ? ccFormatMoneyCsv(header.difference) : ""].map(ccCsvCell).join(","));
  lines.push("");
  lines.push(["Date", "Vendor", "Employee", "Company", "Description", ...catLabels, "Total"].map(ccCsvCell).join(","));
  for (const row of rows) {
    lines.push([row.date, row.vendor, row.employee_initials, row.company, row.description, ...category_keys.map((k) => ccFormatMoneyCsv(row.amounts[k])), ccFormatMoneyCsv(row.total)].map(ccCsvCell).join(","));
  }
  lines.push(["Total", "", "", "", "", ...category_keys.map((k) => ccFormatMoneyCsv(category_totals[k])), ccFormatMoneyCsv(grand_total)].map(ccCsvCell).join(","));
  return "\uFEFF" + lines.join("\n");
}

function ccXmlEsc(value) {
  if (value == null || value === "") return "";
  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function ccSpreadsheetCell(value, asNumber) {
  if (asNumber && value != null && value !== "" && !Number.isNaN(Number(value))) {
    return `<Cell><Data ss:Type="Number">${Number(value)}</Data></Cell>`;
  }
  return `<Cell><Data ss:Type="String">${ccXmlEsc(value)}</Data></Cell>`;
}

function ccSpreadsheetRow(values, numberIndexes) {
  const nums = numberIndexes || new Set();
  return `<Row>${values.map((v, i) => ccSpreadsheetCell(v, nums.has(i))).join("")}</Row>`;
}

/** Excel 2003 XML — opens in Excel without npm libraries. */
function creditCardBillToSpreadsheetXml(exportData) {
  const { header, rows, category_keys, category_totals, grand_total } = exportData;
  const catLabels = EXPORT_CATEGORIES.map((c) => c.label);
  const dataHeaders = ["Date", "Vendor", "Employee", "Company", "Description", ...catLabels, "Total"];
  const moneyIndexes = new Set([5 + catLabels.length]);
  for (let i = 5; i < 5 + catLabels.length; i++) moneyIndexes.add(i);

  const summaryIndexes = new Set([6, 9, 12]);
  const parts = [
    '<?xml version="1.0"?>',
    '<?mso-application progid="Excel.Sheet"?>',
    '<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">',
    '<Worksheet ss:Name="Credit Card Bill"><Table>',
    ccSpreadsheetRow([header.title]),
    ccSpreadsheetRow(["Employee", header.employee_name, "", "", "", "From:", header.date_from, "", "To:", header.date_to]),
    ccSpreadsheetRow(
      ["", "", "", "", "", "Total per Spreadsheet:", header.spreadsheet_total, "", "Total on bill:", header.statement_total ?? "", "", "Difference:", header.difference ?? ""],
      summaryIndexes
    ),
    ccSpreadsheetRow([""]),
    ccSpreadsheetRow(dataHeaders),
  ];

  for (const row of rows) {
    parts.push(
      ccSpreadsheetRow(
        [
          row.date,
          row.vendor,
          row.employee_initials,
          row.company,
          row.description,
          ...category_keys.map((k) => row.amounts[k] || ""),
          row.total,
        ],
        moneyIndexes
      )
    );
  }

  parts.push(
    ccSpreadsheetRow(
      ["Total", "", "", "", "", ...category_keys.map((k) => category_totals[k]), grand_total],
      moneyIndexes
    ),
    "</Table></Worksheet></Workbook>"
  );

  return parts.join("\n");
}

// --- End credit card export ---

const PROFILE_SELECT =
  "id,first_name,last_name,email,phone,role,region,company,card_type,created_at";

const REPORT_SELECT =
  "id,user_id,pay_period_start,pay_period_end,status,grand_total,submitted_at,approved_at,approved_by,total_travel_lodging,total_tolls_parking,total_miles,total_mileage_calc,total_office_supplies,total_meals_entertainment,total_vehicle_maintenance,total_marketing,total_misc";

function mapReportRow(row) {
  return {
    ...row,
    employee: row.profiles || null,
    profiles: undefined,
  };
}

export async function pingDatabase() {
  const settings = await supabaseRest("app_settings?key=eq.mileage_rate&select=key,value");
  return {
    ok: true,
    mileage_rate: settings?.[0]?.value ?? null,
  };
}

export async function getDashboardStats() {
  const [profiles, reports, reminders] = await Promise.all([
    supabaseRest(`profiles?select=id`),
    supabaseRest(`expense_reports?select=status,grand_total`),
    supabaseRest(`expense_reminders?select=status`),
  ]);

  const byStatus = { draft: 0, submitted: 0, approved: 0, rejected: 0 };
  let totalExpenses = 0;

  for (const r of reports || []) {
    byStatus[r.status] = (byStatus[r.status] || 0) + 1;
    if (r.status === "submitted" || r.status === "approved") {
      totalExpenses += Number(r.grand_total || 0);
    }
  }

  let flagged_pending_count = 0;
  let flagged_confirmed_count = 0;
  for (const rem of reminders || []) {
    if (rem.status === "confirmed") flagged_confirmed_count += 1;
    else if (["pending", "notified", "no_receipt", "submitted"].includes(rem.status)) {
      flagged_pending_count += 1;
    }
  }

  return {
    employee_count: (profiles || []).length,
    report_count: (reports || []).length,
    pending_count: byStatus.submitted || 0,
    approved_count: byStatus.approved || 0,
    draft_count: byStatus.draft || 0,
    total_expenses: totalExpenses,
    flagged_pending_count,
    flagged_confirmed_count,
  };
}

export async function listRecentExpenses(limit = 100) {
  const items = await supabaseRest(
    `expense_line_items?select=*,expense_reports(status,pay_period_start,profiles!expense_reports_user_id_fkey(${PROFILE_SELECT}))&order=created_at.desc&limit=${limit}`
  );

  return (items || []).map((item) => {
    const report = item.expense_reports || {};
    const employee = report.profiles || {};
    return {
      ...item,
      report_status: report.status,
      pay_period_start: report.pay_period_start,
      employee,
      expense_reports: undefined,
    };
  });
}

export async function listPendingReports() {
  const reports = await supabaseRest(
    `expense_reports?status=eq.submitted&select=${REPORT_SELECT},profiles!expense_reports_user_id_fkey(${PROFILE_SELECT})&order=submitted_at.asc`
  );
  return (reports || []).map(mapReportRow);
}

export async function listReports(payPeriodStart, payPeriodEnd) {
  let query = `expense_reports?select=${REPORT_SELECT},profiles!expense_reports_user_id_fkey(${PROFILE_SELECT})&order=submitted_at.desc.nullslast`;

  if (payPeriodStart) query += `&pay_period_start=gte.${payPeriodStart}`;
  if (payPeriodEnd) query += `&pay_period_end=lte.${payPeriodEnd}`;

  const reports = await supabaseRest(query);
  return (reports || []).map(mapReportRow);
}

/**
 * Line items with signed receipt image URLs for admin review.
 */
export async function getReportLineItems(reportId) {
  const items = await supabaseRest(
    `expense_line_items?report_id=eq.${reportId}&select=*&order=sort_order.asc`
  );

  const enriched = [];
  for (const item of items || []) {
    enriched.push({
      ...item,
      receipt_image_url: await resolveImageUrl(item.receipt_url),
    });
  }
  return enriched;
}

/**
 * Review payload: line items + all receipt uploads for the report.
 */
export async function getReportReview(reportId) {
  const lineItems = await getReportLineItems(reportId);

  const uploads = await supabaseRest(
    `receipt_uploads?report_id=eq.${reportId}&select=id,storage_path,file_name,created_at,status&order=created_at.asc`
  );

  const receiptGallery = [];
  const seenPaths = new Set(
    lineItems.map((i) => i.receipt_url).filter(Boolean)
  );

  for (const upload of uploads || []) {
    if (!upload.storage_path || seenPaths.has(upload.storage_path)) continue;
    receiptGallery.push({
      ...upload,
      receipt_image_url: await resolveImageUrl(upload.storage_path),
    });
  }

  return { line_items: lineItems, receipt_gallery: receiptGallery };
}

export async function approveReport(reportId, approverName) {
  const rows = await supabaseRest(
    `expense_reports?id=eq.${reportId}&status=eq.submitted`,
    {
      method: "PATCH",
      prefer: "return=representation",
      body: {
        status: "approved",
        approved_at: new Date().toISOString(),
        approved_by: approverName || "Admin",
      },
    }
  );

  if (!rows || rows.length === 0) {
    throw new Error("Report not found or not in submitted status");
  }
  return rows[0];
}

export async function rejectReport(reportId, reason) {
  const rows = await supabaseRest(
    `expense_reports?id=eq.${reportId}&status=eq.submitted`,
    {
      method: "PATCH",
      prefer: "return=representation",
      body: {
        status: "rejected",
        notes: reason || null,
      },
    }
  );

  if (!rows || rows.length === 0) {
    throw new Error("Report not found or not in submitted status");
  }
  return rows[0];
}

export async function listEmployees(region) {
  let query = `profiles?select=${PROFILE_SELECT}&order=last_name.asc,first_name.asc`;
  if (region) query += `&region=eq.${region}`;
  return supabaseRest(query);
}

export async function getRegionSummary(payPeriodStart, payPeriodEnd) {
  let query =
    "expense_reports?status=in.(submitted,approved)&select=grand_total,total_miles,total_mileage_calc,profiles!expense_reports_user_id_fkey(region)";

  if (payPeriodStart) query += `&pay_period_start=gte.${payPeriodStart}`;
  if (payPeriodEnd) query += `&pay_period_end=lte.${payPeriodEnd}`;

  const rows = await supabaseRest(query);
  const summary = {};

  for (const row of rows || []) {
    const region = row.profiles?.region || "unknown";
    if (!summary[region]) {
      summary[region] = {
        region,
        report_count: 0,
        total_expenses: 0,
        total_miles: 0,
        total_mileage_dollars: 0,
      };
    }
    summary[region].report_count += 1;
    summary[region].total_expenses += Number(row.grand_total || 0);
    summary[region].total_miles += Number(row.total_miles || 0);
    summary[region].total_mileage_dollars += Number(row.total_mileage_calc || 0);
  }

  return Object.values(summary).sort((a, b) => a.region.localeCompare(b.region));
}

export async function exportExpenseData(payPeriodStart, payPeriodEnd) {
  let query =
    "expense_reports?status=in.(submitted,approved)&select=id,pay_period_start,pay_period_end,status,grand_total,submitted_at,approved_at,profiles!expense_reports_user_id_fkey(first_name,last_name,email,region,role,company),expense_line_items(sort_order,expense_date,description,related_to,travel_lodging,tolls_parking,miles,mileage_calc,office_supplies,meals_entertainment,vehicle_maintenance,marketing,misc,row_total)";

  if (payPeriodStart) query += `&pay_period_start=gte.${payPeriodStart}`;
  if (payPeriodEnd) query += `&pay_period_end=lte.${payPeriodEnd}`;

  const reports = await supabaseRest(`${query}&order=submitted_at.desc`);
  const flat = [];

  for (const report of reports || []) {
    const profile = report.profiles || {};
    const items = report.expense_line_items || [];

    if (items.length === 0) {
      flat.push({
        employee_name: `${profile.first_name || ""} ${profile.last_name || ""}`.trim(),
        email: profile.email,
        region: profile.region,
        role: profile.role,
        company: profile.company,
        pay_period_start: report.pay_period_start,
        pay_period_end: report.pay_period_end,
        status: report.status,
        grand_total: report.grand_total,
        submitted_at: report.submitted_at,
      });
      continue;
    }

    for (const item of items) {
      flat.push({
        employee_name: `${profile.first_name || ""} ${profile.last_name || ""}`.trim(),
        email: profile.email,
        region: profile.region,
        role: profile.role,
        company: profile.company,
        pay_period_start: report.pay_period_start,
        pay_period_end: report.pay_period_end,
        status: report.status,
        grand_total: report.grand_total,
        submitted_at: report.submitted_at,
        expense_date: item.expense_date,
        description: item.description,
        related_to: item.related_to,
        travel_lodging: item.travel_lodging,
        tolls_parking: item.tolls_parking,
        miles: item.miles,
        mileage_calc: item.mileage_calc,
        office_supplies: item.office_supplies,
        meals_entertainment: item.meals_entertainment,
        vehicle_maintenance: item.vehicle_maintenance,
        marketing: item.marketing,
        misc: item.misc,
        row_total: item.row_total,
      });
    }
  }

  return flat;
}

/**
 * Fetch all submitted/approved line items in a statement window (by expense_date).
 * Used for Mike's Credit Card Bill export — no manual spreadsheet entry.
 */
export async function fetchLineItemsForStatement(dateFrom, dateTo, employeeId) {
  let query =
    "expense_line_items?select=*,expense_reports!inner(status,pay_period_start,pay_period_end,user_id,profiles!expense_reports_user_id_fkey(id,first_name,last_name,email,region,company))&expense_reports.status=in.(submitted,approved)";

  if (dateFrom) query += `&expense_date=gte.${dateFrom}`;
  if (dateTo) query += `&expense_date=lte.${dateTo}`;
  if (employeeId) query += `&expense_reports.user_id=eq.${employeeId}`;

  query += "&order=expense_date.asc,sort_order.asc";

  const items = await supabaseRest(query);

  return (items || []).map((item) => {
    const report = item.expense_reports || {};
    const profile = report.profiles || {};
    return {
      ...item,
      user_id: report.user_id,
      report_status: report.status,
      profile,
      expense_reports: undefined,
    };
  });
}

/**
 * Credit Card Bill export — spreadsheet layout for finance reconciliation.
 */
export async function exportCreditCardBill(dateFrom, dateTo, employeeId, statementTotal) {
  const items = await fetchLineItemsForStatement(dateFrom, dateTo, employeeId || null);
  return buildCreditCardBillExport({
    items,
    employeeFilter: employeeId || null,
    dateFrom,
    dateTo,
    statementTotal,
  });
}

/** CSV body for HTTP download (Excel opens this fine). */
export async function getCreditCardBillCsvBody(dateFrom, dateTo, employeeId, statementTotal) {
  const data = await exportCreditCardBill(dateFrom, dateTo, employeeId, statementTotal);
  return creditCardBillToCsv(data);
}

/** Excel XML (.xls) for HTTP download — no client-side libraries needed. */
export async function getCreditCardBillXlsBody(dateFrom, dateTo, employeeId, statementTotal) {
  const data = await exportCreditCardBill(dateFrom, dateTo, employeeId, statementTotal);
  return creditCardBillToSpreadsheetXml(data);
}

const EXPORT_STORAGE_BUCKET = "exports";

function exportFilenameHint(data) {
  const name = data.header?.employee_name;
  if (name && name !== "All employees") {
    return String(name).replace(/[^\w.-]+/g, "_").slice(0, 40);
  }
  return "All_employees";
}

async function storeExportFile(body, filename, contentType) {
  const path = `admin/${Date.now()}_${filename.replace(/[^\w.-]+/g, "_")}`;
  await uploadStorageObject(EXPORT_STORAGE_BUCKET, path, body, contentType);
  const url = await createSignedStorageUrl(EXPORT_STORAGE_BUCKET, path, 3600);
  if (!url) throw new Error("Could not create download link — is the Supabase exports bucket set up?");
  return { url, filename, path };
}

/**
 * Upload export to Supabase Storage and return signed URLs (works without Wix HTTP functions).
 */
export async function getCreditCardBillDownloadUrls(dateFrom, dateTo, employeeId, statementTotal) {
  const data = await exportCreditCardBill(dateFrom, dateTo, employeeId, statementTotal);
  const hint = exportFilenameHint(data);
  const xlsName = `credit_card_bill_${hint}_${dateFrom}_${dateTo}.xls`;
  const csvName = `credit_card_bill_${hint}_${dateFrom}_${dateTo}.csv`;
  const xlsBody = creditCardBillToSpreadsheetXml(data);
  const csvBody = creditCardBillToCsv(data);

  const [xls, csv] = await Promise.all([
    storeExportFile(xlsBody, xlsName, "application/vnd.ms-excel"),
    storeExportFile(csvBody, csvName, "text/csv; charset=utf-8"),
  ]);

  return {
    filename: xls.filename,
    csvFilename: csv.filename,
    xlsUrl: withDownloadParam(xls.url, xls.filename),
    csvUrl: withDownloadParam(csv.url, csv.filename),
    expiresIn: 3600,
  };
}

function withDownloadParam(url, filename) {
  if (!url) return url;
  const sep = url.includes("?") ? "&" : "?";
  return `${url}${sep}download=${encodeURIComponent(filename)}`;
}

// --- Credit card statement reconciliation ---

function rcRoundMoney(n) {
  return Math.round(Number(n || 0) * 100) / 100;
}

function normalizeParseSource(source) {
  const s = String(source || "manual");
  if (s === "pdf_vision" || s === "pdf_text" || s === "pdf_ai") return "pdf_ai";
  if (s === "xlsx" || s === "csv" || s === "manual") return s;
  return "manual";
}

function rcNormMerchant(value) {
  return String(value || "")
    .toLowerCase()
    .replace(/[^a-z0-9 ]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function rcDaysBetween(a, b) {
  if (!a || !b) return 99;
  const da = new Date(`${a}T12:00:00`);
  const db = new Date(`${b}T12:00:00`);
  return Math.abs(Math.round((da - db) / 86400000));
}

function rcMerchantScore(a, b) {
  const x = rcNormMerchant(a);
  const y = rcNormMerchant(b);
  if (!x || !y) return 0;
  if (x === y) return 1;
  if (x.includes(y) || y.includes(x)) return 0.75;
  const xw = new Set(x.split(" ").filter((w) => w.length > 2));
  const yw = new Set(y.split(" ").filter((w) => w.length > 2));
  let overlap = 0;
  xw.forEach((w) => { if (yw.has(w)) overlap += 1; });
  return overlap ? overlap / Math.max(xw.size, yw.size, 1) : 0;
}

export async function fetchStatementLineItems(dateFrom, dateTo, employeeId) {
  return fetchLineItemsForStatement(dateFrom, dateTo, employeeId || null);
}

/**
 * Match Chase statement lines to submitted app expenses.
 */
export async function reconcileCreditCardStatement(dateFrom, dateTo, employeeId, statementTotal, transactions) {
  const items = await fetchLineItemsForStatement(dateFrom, dateTo, employeeId || null);

  const appLines = (items || []).map((item) => ({
    line_item_id: item.id,
    user_id: item.user_id,
    employee: [item.profile?.first_name, item.profile?.last_name].filter(Boolean).join(" "),
    date: item.expense_date ? String(item.expense_date).slice(0, 10) : null,
    vendor: item.description || item.related_to || "",
    amount: rcRoundMoney(item.row_total),
    matched: false,
  }));

  const stmtLines = (transactions || []).map((t, index) => ({
    id: `stmt_${index}`,
    date: t.date ? String(t.date).slice(0, 10) : null,
    merchant: t.merchant || t.description || "",
    amount: rcRoundMoney(Math.abs(Number(t.amount))),
    category: t.category || null,
    matched: false,
  }));

  const matches = [];

  for (const stmt of stmtLines) {
    let bestIdx = -1;
    let bestScore = 0;
    for (let i = 0; i < appLines.length; i++) {
      const app = appLines[i];
      if (app.matched) continue;
      if (Math.abs(app.amount - stmt.amount) > 0.02) continue;
      const dateDiff = rcDaysBetween(app.date, stmt.date);
      if (dateDiff > 5) continue;
      const score = rcMerchantScore(app.vendor, stmt.merchant) + (dateDiff === 0 ? 0.25 : dateDiff <= 2 ? 0.12 : 0);
      if (score > bestScore) {
        bestScore = score;
        bestIdx = i;
      }
    }
    if (bestIdx >= 0 && bestScore >= 0.2) {
      appLines[bestIdx].matched = true;
      stmt.matched = true;
      matches.push({
        statement: stmt,
        expense: appLines[bestIdx],
        confidence: Math.round(bestScore * 100) / 100,
      });
    }
  }

  const missingOnApp = stmtLines.filter((s) => !s.matched);
  const missingOnBill = appLines.filter((a) => !a.matched);
  const statementSum = rcRoundMoney(stmtLines.reduce((sum, t) => sum + t.amount, 0));
  const appSum = rcRoundMoney(appLines.reduce((sum, t) => sum + t.amount, 0));
  const billTotal = statementTotal != null ? rcRoundMoney(statementTotal) : statementSum;

  return {
    summary: {
      statement_count: stmtLines.length,
      app_count: appLines.length,
      matched_count: matches.length,
      missing_on_app_count: missingOnApp.length,
      missing_on_bill_count: missingOnBill.length,
      statement_total: billTotal,
      statement_parsed_total: statementSum,
      app_total: appSum,
      difference: rcRoundMoney(billTotal - appSum),
    },
    matches,
    missing_on_app: missingOnApp,
    missing_on_bill: missingOnBill,
  };
}

/** Upload a small PDF via backend (fallback when signed URL fails). */
export async function uploadStatementPdf(fileBase64, fileName) {
  if (!fileBase64) throw new Error("fileBase64 required");
  const safe = String(fileName || "statement.pdf").replace(/[^\w.-]+/g, "_").slice(0, 80);
  const storagePath = `uploads/${Date.now()}_${safe}`;
  const raw = typeof atob === "function" ? atob(fileBase64) : Buffer.from(fileBase64, "base64").toString("binary");
  const bytes = new Uint8Array(raw.length);
  for (let i = 0; i < raw.length; i++) bytes[i] = raw.charCodeAt(i);
  await uploadStorageObject("statements", storagePath, bytes, "application/pdf");
  return { storagePath };
}

/** Signed upload URL for statement PDFs — embed uploads directly to Supabase storage. */
export async function prepareStatementUpload(fileName) {
  const safe = String(fileName || "statement.pdf").replace(/[^\w.-]+/g, "_").slice(0, 80);
  const storagePath = `uploads/${Date.now()}_${safe}`;
  const signed = await createSignedUploadUrl("statements", storagePath);
  return {
    storagePath: signed.path || storagePath,
    signedUrl: signed.signedUrl,
    token: signed.token,
  };
}

/** Config for browser → Supabase edge function (PDF AI parse). */
export async function getStatementAnalyzeInvokeConfig() {
  return getStatementAnalyzeInvoke();
}

/** Config for browser → Supabase edge function (reconcile line items). */
export async function getReconcileItemsInvokeConfig() {
  return getReconcileItemsInvoke();
}

/** Call Supabase edge function to parse PDF statements with AI. */
export async function analyzeStatementFile(fileBase64, mimeType, fileName, storagePath) {
  return invokeAnalyzeStatement({ fileBase64, mimeType, fileName, storagePath });
}

export async function saveCreditCardStatement(payload) {
  const rows = await supabaseRest("cc_statements", {
    method: "POST",
    body: {
      card_type: payload.cardType || null,
      statement_end: payload.statementEnd || null,
      date_from: payload.dateFrom,
      date_to: payload.dateTo,
      statement_total: payload.statementTotal != null ? rcRoundMoney(payload.statementTotal) : null,
      file_name: payload.fileName || null,
      storage_path: payload.storagePath || null,
      parse_source: normalizeParseSource(payload.parseSource),
      transactions: payload.transactions || [],
    },
    prefer: "return=representation",
  });
  return rows?.[0] || rows;
}

export async function createExpenseReminder(userId, merchant, amount, expenseDate, note) {
  const rows = await supabaseRest("expense_reminders", {
    method: "POST",
    body: {
      user_id: userId,
      merchant: String(merchant || "Unknown").slice(0, 200),
      amount: rcRoundMoney(amount),
      expense_date: expenseDate || null,
      note: note || null,
      status: "pending",
    },
    prefer: "return=representation",
  });
  return rows?.[0] || rows;
}

function extractReminderId(row) {
  if (!row) return null;
  if (typeof row === "string") return row;
  if (Array.isArray(row)) return row[0]?.id || null;
  return row.id || null;
}

/**
 * Flag a missing card charge → DB reminder + Expo push to employee's device.
 * Push failures are non-fatal — the reminder row is still saved.
 */
export async function flagAndNotifyEmployee(userId, merchant, amount, expenseDate, note) {
  if (!userId) throw new Error("Select the cardholder before flagging.");
  const cleanMerchant = String(merchant || "Unknown").slice(0, 200);
  const cleanAmount = rcRoundMoney(amount);
  if (!Number.isFinite(cleanAmount) || cleanAmount <= 0) {
    throw new Error("Invalid charge amount — refresh reconciliation and try again.");
  }

  const pushNote =
    note ||
    `Charge on your card: $${cleanAmount.toFixed(2)} at ${cleanMerchant}. ` +
    "Open PDX Expense to upload a receipt or explain this charge.";

  let reminderId = null;
  let alreadyNotified = false;
  try {
    const existing = await supabaseRest(
      `expense_reminders?user_id=eq.${encodeURIComponent(userId)}` +
        `&amount=eq.${cleanAmount}&status=in.(pending,notified)` +
        (expenseDate ? `&expense_date=eq.${encodeURIComponent(expenseDate)}` : "") +
        "&select=id,merchant,notified_at&limit=5"
    );
    const match = (existing || []).find(
      (row) => rcNormMerchant(row.merchant) === rcNormMerchant(cleanMerchant)
    );
    if (match?.id) {
      reminderId = match.id;
      alreadyNotified = Boolean(match.notified_at);
    }
  } catch (_) {}

  if (!reminderId) {
    try {
      const created = await createExpenseReminder(
        userId,
        cleanMerchant,
        cleanAmount,
        expenseDate,
        pushNote
      );
      reminderId = extractReminderId(created);
    } catch (err) {
      const msg = String(err?.message || err || "");
      if (/expense_reminders|schema cache|does not exist/i.test(msg)) {
        throw new Error(
          "expense_reminders table missing — run supabase/expense-reminders-migration.sql in Supabase SQL editor."
        );
      }
      if (/foreign key|profiles/i.test(msg)) {
        throw new Error("Invalid cardholder — pick the employee from the Cardholder dropdown.");
      }
      throw new Error(msg || "Could not save expense reminder.");
    }
  }

  if (!reminderId) {
    throw new Error("Reminder saved but no id returned — check Supabase expense_reminders table.");
  }

  let sent = 0;
  let pushWarning = null;
  if (alreadyNotified) {
    return { reminderId, sent: 0, pushWarning: null, success: true, skipped: true };
  }
  try {
    const push = await invokeSendPush({
      action: "missing_expense_service",
      reminderId,
      userId,
      merchant: cleanMerchant,
      amount: cleanAmount,
      expenseDate: expenseDate || null,
      note: pushNote,
    });
    sent = push.sent || 0;
    pushWarning = push.pushWarning || null;
  } catch (err) {
    pushWarning =
      String(err?.message || err || "Push failed") +
      " Reminder was saved — employee can still see it in the app Notifications tab.";
  }

  return {
    reminderId,
    sent,
    pushWarning,
    success: true,
  };
}

const FLAGGED_REMINDER_SELECT =
  "id,user_id,merchant,amount,expense_date,note,status,notified_at,submitted_at,confirmed_at,created_at,resolution,expense_line_item_id," +
  `profiles!expense_reminders_user_id_fkey(${PROFILE_SELECT}),` +
  "expense_line_items!expense_line_item_id(receipt_url,description,row_total,expense_date)";

const FLAGGED_REMINDER_SELECT_BASIC =
  "id,user_id,merchant,amount,expense_date,note,status,notified_at,submitted_at,created_at," +
  `profiles!expense_reminders_user_id_fkey(${PROFILE_SELECT})`;

function mapFlaggedReminderRow(row) {
  const profile = row.profiles || {};
  const line = row.expense_line_items || null;
  return {
    id: row.id,
    user_id: row.user_id,
    merchant: row.merchant,
    amount: rcRoundMoney(row.amount),
    expense_date: row.expense_date ? String(row.expense_date).slice(0, 10) : null,
    note: row.note,
    status: row.status,
    resolution: row.resolution || null,
    notified_at: row.notified_at,
    submitted_at: row.submitted_at,
    confirmed_at: row.confirmed_at,
    created_at: row.created_at,
    expense_line_item_id: row.expense_line_item_id || null,
    employee: {
      first_name: profile.first_name,
      last_name: profile.last_name,
      email: profile.email,
      company: profile.company,
      region: profile.region,
      role: profile.role,
      card_type: profile.card_type,
    },
    expense: line
      ? {
          description: line.description,
          row_total: line.row_total,
          expense_date: line.expense_date,
          receipt_url: line.receipt_url,
        }
      : null,
  };
}

async function enrichFlaggedReminders(rows) {
  const mapped = (rows || []).map(mapFlaggedReminderRow);
  await Promise.all(
    mapped.map(async (row) => {
      if (row.expense?.receipt_url) {
        row.receipt_image_url = await resolveImageUrl(row.expense.receipt_url);
      }
    })
  );
  return mapped;
}

async function fetchFlaggedRemindersRows(statusQuery, orderQuery) {
  try {
    return await supabaseRest(
      `expense_reminders?${statusQuery}&select=${FLAGGED_REMINDER_SELECT}&${orderQuery}&limit=500`
    );
  } catch (err) {
    const msg = String(err?.message || err || "");
    if (/confirmed_at|resolution|expense_line_item|relationship|schema cache/i.test(msg)) {
      return supabaseRest(
        `expense_reminders?${statusQuery}&select=${FLAGGED_REMINDER_SELECT_BASIC}&order=created_at.desc&limit=500`
      );
    }
    throw err;
  }
}

/** Admin queue — flagged charges awaiting employee or finance review. */
export async function listFlaggedPending() {
  const rows = await fetchFlaggedRemindersRows(
    "status=in.(pending,notified,no_receipt,submitted)",
    "order=created_at.desc"
  );
  return enrichFlaggedReminders(rows);
}

/** Bookkeeping — validated flagged charges (receipt uploaded or admin confirmed). */
export async function listFlaggedConfirmed() {
  const rows = await fetchFlaggedRemindersRows(
    "status=eq.confirmed",
    "order=confirmed_at.desc.nullslast,created_at.desc"
  );
  return enrichFlaggedReminders(rows);
}

/** Manual confirm (e.g. employee marked no receipt, or manual entry without receipt). */
export async function confirmFlaggedReminder(reminderId, approverName) {
  const rows = await supabaseRest(
    `expense_reminders?id=eq.${encodeURIComponent(reminderId)}&status=in.(no_receipt,submitted,pending,notified)`,
    {
      method: "PATCH",
      prefer: "return=representation",
      body: {
        status: "confirmed",
        confirmed_at: new Date().toISOString(),
        resolution: "admin",
      },
    }
  );
  if (!rows?.[0]) throw new Error("Reminder not found or already confirmed");
  return mapFlaggedReminderRow(rows[0]);
}

/** Dismiss a flagged charge from the pending queue. */
export async function dismissFlaggedReminder(reminderId) {
  const rows = await supabaseRest(
    `expense_reminders?id=eq.${encodeURIComponent(reminderId)}&status=neq.confirmed`,
    {
      method: "PATCH",
      prefer: "return=representation",
      body: { status: "dismissed" },
    }
  );
  if (!rows?.[0]) throw new Error("Reminder not found");
  return mapFlaggedReminderRow(rows[0]);
}

/**
 * Single entry point for Velo page code — avoids fragile multi-import bundles.
 */
export async function handlePdxAdminRequest(action, params = {}) {
  switch (action) {
    case "ping": return pingDatabase();
    case "stats": return getDashboardStats();
    case "listRecentExpenses": return listRecentExpenses(params.limit);
    case "listPending": return listPendingReports();
    case "listReports": return listReports(params.payPeriodStart, params.payPeriodEnd);
    case "getLineItems": return getReportLineItems(params.reportId);
    case "getReportReview": return getReportReview(params.reportId);
    case "approve": return approveReport(params.reportId, params.approverName);
    case "reject": return rejectReport(params.reportId, params.reason);
    case "listEmployees": return listEmployees(params.region);
    case "regionSummary": return getRegionSummary(params.payPeriodStart, params.payPeriodEnd);
    case "export": return exportExpenseData(params.payPeriodStart, params.payPeriodEnd);
    case "exportCreditCardBill":
      return exportCreditCardBill(params.dateFrom, params.dateTo, params.employeeId, params.statementTotal);
    case "getExportDownloadUrls":
      return getCreditCardBillDownloadUrls(params.dateFrom, params.dateTo, params.employeeId, params.statementTotal);
    case "reconcileCreditCardStatement":
      return reconcileCreditCardStatement(
        params.dateFrom,
        params.dateTo,
        params.employeeId,
        params.statementTotal,
        params.transactions
      );
    case "fetchStatementLineItems":
      return fetchStatementLineItems(params.dateFrom, params.dateTo, params.employeeId);
    case "getStatementAnalyzeInvoke":
      return getStatementAnalyzeInvokeConfig();
    case "getReconcileItemsInvoke":
      return getReconcileItemsInvokeConfig();
    case "prepareStatementUpload":
      return prepareStatementUpload(params.fileName);
    case "uploadStatementPdf":
      return uploadStatementPdf(params.fileBase64, params.fileName);
    case "analyzeStatementFile":
      return analyzeStatementFile(params.fileBase64, params.mimeType, params.fileName, params.storagePath);
    case "saveCreditCardStatement":
      return saveCreditCardStatement(params);
    case "flagAndNotifyEmployee":
      return flagAndNotifyEmployee(
        params.userId,
        params.merchant,
        params.amount,
        params.expenseDate,
        params.note
      );
    case "createExpenseReminder":
      return createExpenseReminder(
        params.userId,
        params.merchant,
        params.amount,
        params.expenseDate,
        params.note
      );
    case "listFlaggedPending":
      return listFlaggedPending();
    case "listFlaggedConfirmed":
      return listFlaggedConfirmed();
    case "confirmFlaggedReminder":
      return confirmFlaggedReminder(params.reminderId, params.approverName);
    case "dismissFlaggedReminder":
      return dismissFlaggedReminder(params.reminderId);
    default:
      throw new Error(`Unknown action: ${action}`);
  }
}
